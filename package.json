{
  "name": "cardwall",
  "version": "0.8.0",
  "description": "力导向整齐树卡片墙笔记工具 — 自由拖拽每个节点、松手不回弹，一键整洁回到标准树；桌面 (Electron) + 网页双版，手机可触控",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test \"test/**/*.test.mjs\"",
    "build:web": "scripts/build-web.sh",
    "dist": "electron-builder --mac dmg"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.franky100.cardwall",
    "productName": "cardwall",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "title": "cardwall",
      "icon": "build/icon.icns"
    }
  }
}
